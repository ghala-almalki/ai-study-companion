# Copy this file to a new file named ".env" and put your own values

# Your Google Gemini API key (create one in Google AI Studio)
GEMINI_API_KEY=your_key_here

# Which Gemini model to use
GEMINI_MODEL=gemini-3.5-flash-lite

# Websites that are allowed to call the backend (separated by commas)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000